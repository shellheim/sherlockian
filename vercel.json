{
       "trailingSlash": true,
       "headers": [
              {
                     "source": "/fonts/(.*)",
                     "headers": [
                            {
                                   "key": "Cache-Control",
                                   "value": "public, max-age=31536000, immutable"
                            }
                     ]
              },
              {
                     "source": "/images/illustrations/(.*)",
                     "headers": [
                            {
                                   "key": "Cache-Control",
                                   "value": "public, max-age=31536000, immutable"
                            }
                     ]
              },
              {
                     "source": "/(.*)",
                     "headers": [
                            {
                                   "key": "X-Content-Type-Options",
                                   "value": "nosniff"
                            },
                            {
                                   "key": "Referrer-Policy",
                                   "value": "strict-origin-when-cross-origin"
                            }
                     ]
              }
       ]
}
